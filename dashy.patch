 const { URL } = require('url');
+const fs = require('fs');
+const path = require('path');
+const yaml = require('./yaml');
+
+const PAGE = path.resolve(__dirname, '..', '..', process.env.USER_DATA_DIR || 'user-data', 'conf.yml');
+
+const STATUS_PAGE_WIDGET = 'uptime-kuma-status-page';
+
+const NOT_SERVICES = new Set([
+  'localhost', 'ip6-localhost', 'ip6-loopback', 'ip6-localnet', 'ip6-mcastprefix',
+  'ip6-allnodes', 'ip6-allrouters', 'metadata', 'instance-data', 'kubernetes',
+]);
+
+const CONTAINER_ID = /^(?:[0-9a-f]{12}|[0-9a-f]{64})$/;
+
+const STACK_SERVICE = /^(?=[a-z0-9-]*[a-z])[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/;
+
+const stackService = (name) => STACK_SERVICE.test(name) && !NOT_SERVICES.has(name) && !CONTAINER_ID.test(name);
+
+const hrefOf = (raw) => {
+  try { return new URL(raw).href; } catch (e) { return null; }
+};
+
+const listOf = (value) => (Array.isArray(value) ? value : []);
+
+const namedByThePage = () => {
+  let page;
+  try { page = yaml.load(fs.readFileSync(PAGE, 'utf8')) || {}; } catch (e) { return new Set(); }
+  const everyItem = Boolean(page.appConfig && page.appConfig.statusCheck);
+  const named = [];
+  listOf(page.sections).forEach((section) => {
+    listOf(section && section.items).forEach((item) => {
+      const checked = item && (item.statusCheck === undefined ? everyItem : item.statusCheck);
+      if (checked) named.push(item.statusCheckUrl || item.url);
+    });
+    listOf(section && section.widgets).forEach((widget) => {
+      const options = (widget && widget.options) || {};
+      if (widget && widget.type === STATUS_PAGE_WIDGET && options.host && options.slug) {
+        named.push(`${options.host}/api/status-page/heartbeat/${options.slug}`);
+        named.push(`${options.host}/api/status-page/${options.slug}`);
+      }
+    });
+  });
+  return new Set(named.map(hrefOf).filter((href) => href && stackService(new URL(href).hostname)));
+};
 
